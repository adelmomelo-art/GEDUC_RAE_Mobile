rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function caminhoUsuarioAtual() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function usuarioExiste() {
      return autenticado() && exists(caminhoUsuarioAtual());
    }

    function usuarioAtual() {
      return get(caminhoUsuarioAtual());
    }

    function perfilAtual() {
      return usuarioAtual().data.perfilAcesso;
    }

    function perfilReconhecido() {
      return usuarioExiste()
        && usuarioAtual().data.perfilAcesso is string
        && perfilAtual() in [
          'administrador',
          'gestor',
          'coordenador',
          'agente'
        ];
    }

    function usuarioAtivo() {
      return perfilReconhecido()
        && usuarioAtual().data.ativo == true;
    }

    function possuiPerfil(perfis) {
      return usuarioAtivo() && perfilAtual() in perfis;
    }

    function administrador() {
      return possuiPerfil(['administrador']);
    }

    function administradorOuGestor() {
      return possuiPerfil(['administrador', 'gestor']);
    }

    function domainValido() {
      return request.resource.data.keys().hasAll([
          'grupo',
          'codigo',
          'nome',
          'ordem',
          'ativo',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.grupo is string
        && request.resource.data.grupo.size() > 0
        && request.resource.data.codigo is string
        && request.resource.data.codigo.size() > 0
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.ordem is int
        && request.resource.data.ativo is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function createdAtPreservadoOuRegularizado() {
      return (
          resource.data.keys().hasAll(['createdAt'])
          && resource.data.createdAt is timestamp
          && request.resource.data.createdAt == resource.data.createdAt
        ) || (
          !resource.data.keys().hasAll(['createdAt'])
          && request.resource.data.createdAt
            == request.resource.data.updatedAt
        );
    }

    function membroEquipeValido() {
      return request.resource.data.keys().hasAll([
          'usuarioId',
          'nome',
          'vinculo',
          'podeCoordenar',
          'ativo',
          'origem',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.usuarioId is string
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.vinculo in ['agente', 'terceirizado']
        && request.resource.data.podeCoordenar is bool
        && request.resource.data.ativo is bool
        && request.resource.data.origem is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function escopoAcessoValido() {
      return request.resource.data.keys().hasAll([
          'escopoAcesso',
          'scopeUpdatedAt',
          'scopeUpdatedBy'
        ])
        && request.resource.data.escopoAcesso is map
        && request.resource.data.escopoAcesso.keys().hasOnly([
          'regionalIds',
          'equipeIds',
          'projetoIds',
          'scopeVersion'
        ])
        && request.resource.data.escopoAcesso.keys().hasAll([
          'regionalIds',
          'equipeIds',
          'projetoIds',
          'scopeVersion'
        ])
        && request.resource.data.escopoAcesso.regionalIds is list
        && request.resource.data.escopoAcesso.equipeIds is list
        && request.resource.data.escopoAcesso.projetoIds is list
        && request.resource.data.escopoAcesso.scopeVersion is int
        && request.resource.data.escopoAcesso.scopeVersion > 0
        && request.resource.data.scopeUpdatedAt is timestamp
        && request.resource.data.scopeUpdatedBy == request.auth.uid;
    }

    function equipeValida() {
      return request.resource.data.keys().hasAll([
          'nome',
          'codigo',
          'regionalIds',
          'membroIds',
          'coordenadorUserIds',
          'ativo'
        ])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.codigo is string
        && request.resource.data.regionalIds is list
        && request.resource.data.membroIds is list
        && request.resource.data.coordenadorUserIds is list
        && request.resource.data.ativo is bool;
    }

    function projetoValido() {
      return request.resource.data.keys().hasAll([
          'nome',
          'codigo',
          'categoria',
          'descricao',
          'objetivo',
          'publicoAlvo',
          'palavrasChave',
          'aliases',
          'regionalIds',
          'equipeIds',
          'ordem',
          'ativo'
        ])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.codigo is string
        && request.resource.data.codigo.size() > 0
        && request.resource.data.categoria is string
        && request.resource.data.categoria.size() > 0
        && request.resource.data.descricao is string
        && request.resource.data.objetivo is string
        && request.resource.data.publicoAlvo is string
        && request.resource.data.palavrasChave is list
        && request.resource.data.aliases is list
        // Compatibilidade legada. Listas vazias sao validas e nao
        // representam vinculo operacional obrigatorio do RAE.
        && request.resource.data.regionalIds is list
        && request.resource.data.equipeIds is list
        && request.resource.data.ordem is int
        && request.resource.data.ordem >= 0
        && request.resource.data.ativo is bool;
    }

    // ESC-001C - Autorização isolada do módulo Escala.
    // Não reutiliza usuarioAtivo() para o Gerente, evitando ampliar o ACL
    // legado de RAE e demais coleções.
    function perfilEscalaAtual() {
      return usuarioAtual().data.perfilAcesso;
    }

    function usuarioEscalaAtivo() {
      return usuarioExiste()
        && usuarioAtual().data.ativo == true
        && usuarioAtual().data.perfilAcesso is string
        && perfilEscalaAtual() in [
          'administrador',
          'gestor',
          'gerente',
          'coordenador',
          'agente'
        ];
    }

    function administradorEscala() {
      return usuarioEscalaAtivo()
        && perfilEscalaAtual() == 'administrador';
    }

    function gerenteEscala() {
      return usuarioEscalaAtivo()
        && perfilEscalaAtual() == 'gerente';
    }

    function caminhoConfiguracaoEscala() {
      return /databases/$(database)/documents/escala_configuracoes/principal;
    }

    function responsavelEscalaAtivo() {
      return usuarioEscalaAtivo()
        && perfilEscalaAtual() == 'agente'
        && exists(caminhoConfiguracaoEscala())
        && get(caminhoConfiguracaoEscala()).data.ativo == true
        && get(caminhoConfiguracaoEscala()).data.responsavelEscalaUsuarioId
          == request.auth.uid;
    }

    function podeCriarEscala() {
      return responsavelEscalaAtivo();
    }

    function podeAtualizarEscala() {
      return gerenteEscala() || responsavelEscalaAtivo();
    }

    function escalaRascunhoPorId(escalaId) {
      return escalaId is string
        && escalaId.size() > 0
        && exists(/databases/$(database)/documents/escalas/$(escalaId))
        && get(/databases/$(database)/documents/escalas/$(escalaId)).data.status == 'rascunho';
    }

    function podeDesignarResponsavelEscala() {
      return administradorEscala() || gerenteEscala();
    }

    function caminhoMembroEquipe(membroId) {
      return /databases/$(database)/documents/equipe_operacional/$(membroId);
    }

    function membroEquipeAtivo(membroId) {
      return membroId is string
        && membroId.size() > 0
        && exists(caminhoMembroEquipe(membroId))
        && get(caminhoMembroEquipe(membroId)).data.ativo == true;
    }

    function membroEquipeCompativelComUsuario(membroId, usuarioId) {
      return membroEquipeAtivo(membroId)
        && usuarioId is string
        && (
          usuarioId.size() == 0
          || get(caminhoMembroEquipe(membroId)).data.usuarioId == usuarioId
        );
    }

    function responsavelEscalaValido() {
      let uid = request.resource.data.responsavelEscalaUsuarioId;
      let membroId = request.resource.data.responsavelEscalaMembroEquipeId;
      let caminho = /databases/$(database)/documents/usuarios/$(uid);
      return uid is string
        && uid.size() > 0
        && membroId is string
        && membroId.size() > 0
        && exists(caminho)
        && get(caminho).data.ativo == true
        && get(caminho).data.perfilAcesso == 'agente'
        && membroEquipeAtivo(membroId)
        && get(caminhoMembroEquipe(membroId)).data.usuarioId == uid;
    }

    function configuracaoEscalaValida() {
      return request.resource.data.keys().hasOnly([
          'responsavelEscalaUsuarioId',
          'responsavelEscalaMembroEquipeId',
          'ativo',
          'designadoPor',
          'designadoEm'
        ])
        && request.resource.data.responsavelEscalaUsuarioId is string
        && request.resource.data.responsavelEscalaMembroEquipeId is string
        && request.resource.data.ativo is bool
        && request.resource.data.designadoPor == request.auth.uid
        && request.resource.data.designadoEm is timestamp
        && responsavelEscalaValido();
    }

    function perfilOperacionalEscalaValido() {
      return request.resource.data.keys().hasOnly([
          'membroEquipeId',
          'usuarioId',
          'setorCodigo',
          'cargaHorariaCodigo',
          'ativo',
          'criadoPor',
          'criadoEm',
          'atualizadoPor',
          'atualizadoEm'
        ])
        && request.resource.data.membroEquipeId is string
        && request.resource.data.usuarioId is string
        && request.resource.data.setorCodigo is string
        && request.resource.data.setorCodigo.size() > 0
        && request.resource.data.cargaHorariaCodigo is string
        && request.resource.data.cargaHorariaCodigo.size() > 0
        && request.resource.data.ativo is bool
        && request.resource.data.criadoPor is string
        && request.resource.data.criadoPor.size() > 0
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.atualizadoPor == request.auth.uid
        && request.resource.data.atualizadoEm is timestamp
        && membroEquipeCompativelComUsuario(
          request.resource.data.membroEquipeId,
          request.resource.data.usuarioId
        );
    }

    function escalaValida() {
      return request.resource.data.keys().hasOnly([
          'data',
          'status',
          'versao',
          'observacaoGeral',
          'motivoRevisao',
          'criadoPor',
          'criadoEm',
          'atualizadoPor',
          'atualizadoEm',
          'publicadoPor',
          'publicadoEm'
        ])
        && request.resource.data.data is timestamp
        && request.resource.data.status in ['rascunho', 'publicada', 'arquivada']
        && request.resource.data.versao is int
        && request.resource.data.versao > 0
        && request.resource.data.observacaoGeral is string
        && request.resource.data.motivoRevisao is string
        && request.resource.data.criadoPor is string
        && request.resource.data.criadoPor.size() > 0
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.atualizadoPor == request.auth.uid
        && request.resource.data.atualizadoEm is timestamp
        && request.resource.data.publicadoPor is string
        && (
          request.resource.data.publicadoEm == null
          || request.resource.data.publicadoEm is timestamp
        )
        && (
          (
            request.resource.data.status == 'rascunho'
            && request.resource.data.publicadoPor.size() == 0
            && request.resource.data.publicadoEm == null
          )
          || (
            request.resource.data.status in ['publicada', 'arquivada']
            && request.resource.data.publicadoPor.size() > 0
            && request.resource.data.publicadoEm is timestamp
          )
        );
    }

    function criacaoEscalaValida() {
      return escalaValida()
        && request.resource.data.status == 'rascunho'
        && request.resource.data.versao == 1
        && request.resource.data.criadoPor == request.auth.uid;
    }

    function atualizacaoEscalaValida() {
      return escalaValida()
        && request.resource.data.data == resource.data.data
        && request.resource.data.criadoPor == resource.data.criadoPor
        && request.resource.data.criadoEm == resource.data.criadoEm
        && resource.data.status != 'arquivada'
        && (
          (
            resource.data.status == 'rascunho'
            && request.resource.data.status in ['rascunho', 'publicada']
            && request.resource.data.versao == resource.data.versao
          )
          || (
            resource.data.status == 'publicada'
            && request.resource.data.status in ['publicada', 'arquivada']
            && request.resource.data.versao == resource.data.versao + 1
            && request.resource.data.motivoRevisao.size() > 0
          )
        )
        && (
          request.resource.data.status != 'publicada'
          || (
            request.resource.data.publicadoPor == request.auth.uid
            && request.resource.data.publicadoEm is timestamp
          )
        );
    }

    function coordenadorAtividadeValido() {
      let membroId = request.resource.data.coordenadorMembroEquipeId;
      let usuarioId = request.resource.data.coordenadorUsuarioId;
      return (
          membroId.size() == 0
          && usuarioId.size() == 0
          && request.resource.data.coordenadorNomeSnapshot.size() == 0
        ) || (
          membroEquipeAtivo(membroId)
          && get(caminhoMembroEquipe(membroId)).data.podeCoordenar == true
          && (
            usuarioId.size() == 0
            || get(caminhoMembroEquipe(membroId)).data.usuarioId == usuarioId
          )
          && request.resource.data.coordenadorNomeSnapshot.size() > 0
        );
    }

    function atividadeEscalaValida() {
      return request.resource.data.keys().hasOnly([
          'escalaId',
          'data',
          'secaoId',
          'tipoAtividadeId',
          'naturezaAtividade',
          'titulo',
          'descricao',
          'turnoId',
          'qtrHorario',
          'horaInicio',
          'horaFim',
          'qthLocal',
          'qthEndereco',
          'qthRegionalId',
          'qthPontoReferencia',
          'orientacaoOperacional',
          'coordenadorMembroEquipeId',
          'coordenadorUsuarioId',
          'coordenadorNomeSnapshot',
          'participanteUsuarioIds',
          'geraRae',
          'contabilizaProdutividade',
          'raeId',
          'execucaoMissaoId',
          'status',
          'criadoPor',
          'criadoEm',
          'atualizadoPor',
          'atualizadoEm'
        ])
        && request.resource.data.escalaId is string
        && request.resource.data.escalaId.size() > 0
        && request.resource.data.data is timestamp
        && request.resource.data.secaoId is string
        && request.resource.data.tipoAtividadeId is string
        && request.resource.data.tipoAtividadeId.size() > 0
        && request.resource.data.naturezaAtividade in ['educativa', 'administrativa']
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() > 0
        && request.resource.data.descricao is string
        && request.resource.data.turnoId is string
        && request.resource.data.qtrHorario is string
        && request.resource.data.horaInicio is string
        && request.resource.data.horaFim is string
        && request.resource.data.qthLocal is string
        && request.resource.data.qthEndereco is string
        && request.resource.data.qthRegionalId is string
        && request.resource.data.qthPontoReferencia is string
        && request.resource.data.orientacaoOperacional is string
        && request.resource.data.coordenadorMembroEquipeId is string
        && request.resource.data.coordenadorUsuarioId is string
        && request.resource.data.coordenadorNomeSnapshot is string
        && request.resource.data.participanteUsuarioIds is list
        && request.resource.data.geraRae is bool
        && request.resource.data.contabilizaProdutividade is bool
        && request.resource.data.raeId is string
        && request.resource.data.execucaoMissaoId is string
        && request.resource.data.status in [
          'planejada',
          'publicada',
          'em_execucao',
          'concluida',
          'cancelada'
        ]
        && request.resource.data.criadoPor is string
        && request.resource.data.criadoPor.size() > 0
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.atualizadoPor == request.auth.uid
        && request.resource.data.atualizadoEm is timestamp
        && (
          (
            request.resource.data.naturezaAtividade == 'educativa'
            && request.resource.data.geraRae == true
          )
          || (
            request.resource.data.naturezaAtividade == 'administrativa'
            && request.resource.data.geraRae == false
          )
        )
        && coordenadorAtividadeValido();
    }

    function jornadaComplementarEscala() {
      return request.resource.data.tipoJornada in ['hora_extra', 'banco_horas'];
    }

    function classificacaoJornadaEscalaValida() {
      return request.resource.data.tipoJornada in [
          'normal',
          'hora_extra',
          'banco_horas'
        ]
        && request.resource.data.horaInicioReal is string
        && request.resource.data.horaFimReal is string
        && request.resource.data.minutosPrevistos is int
        && request.resource.data.minutosPrevistos >= 0
        && request.resource.data.minutosPrevistos <= 1440
        && (
          request.resource.data.minutosRealizados == null
          || (
            request.resource.data.minutosRealizados is int
            && request.resource.data.minutosRealizados >= 0
            && request.resource.data.minutosRealizados <= 1440
          )
        )
        && request.resource.data.motivoJornadaComplementar is string
        && request.resource.data.classificadoPor is string
        && (
          request.resource.data.classificadoEm == null
          || request.resource.data.classificadoEm is timestamp
        )
        && (
          !jornadaComplementarEscala()
          || (
            request.resource.data.motivoJornadaComplementar.size() > 0
            && request.resource.data.classificadoPor.size() > 0
            && request.resource.data.classificadoEm is timestamp
          )
        );
    }

    function criacaoClassificacaoJornadaEscalaValida() {
      return !jornadaComplementarEscala()
        || (
          responsavelEscalaAtivo()
          && request.resource.data.classificadoPor == request.auth.uid
        );
    }

    function atualizacaoClassificacaoJornadaEscalaValida() {
      let mudou = request.resource.data.tipoJornada != resource.data.tipoJornada
        || request.resource.data.motivoJornadaComplementar
          != resource.data.motivoJornadaComplementar
        || request.resource.data.classificadoPor != resource.data.classificadoPor
        || request.resource.data.classificadoEm != resource.data.classificadoEm;
      return !mudou
        || (
          responsavelEscalaAtivo()
          && request.resource.data.classificadoPor == request.auth.uid
        );
    }

    function alocacaoEscalaValida() {
      return request.resource.data.keys().hasOnly([
          'escalaId',
          'atividadeId',
          'data',
          'membroEquipeId',
          'usuarioId',
          'nomeSnapshot',
          'vinculoSnapshot',
          'setorSnapshot',
          'cargaHorariaSnapshot',
          'funcaoNaAtividade',
          'turnoId',
          'horaInicio',
          'horaFim',
          'tipoJornada',
          'horaInicioReal',
          'horaFimReal',
          'minutosPrevistos',
          'minutosRealizados',
          'motivoJornadaComplementar',
          'classificadoPor',
          'classificadoEm',
          'observacao',
          'criadoPor',
          'criadoEm',
          'atualizadoPor',
          'atualizadoEm'
        ])
        && request.resource.data.escalaId is string
        && request.resource.data.escalaId.size() > 0
        && request.resource.data.atividadeId is string
        && request.resource.data.atividadeId.size() > 0
        && request.resource.data.data is timestamp
        && membroEquipeCompativelComUsuario(
          request.resource.data.membroEquipeId,
          request.resource.data.usuarioId
        )
        && request.resource.data.nomeSnapshot is string
        && request.resource.data.nomeSnapshot.size() > 0
        && request.resource.data.vinculoSnapshot in ['agente', 'terceirizado']
        && request.resource.data.setorSnapshot is string
        && request.resource.data.cargaHorariaSnapshot is string
        && request.resource.data.funcaoNaAtividade is string
        && request.resource.data.turnoId is string
        && request.resource.data.horaInicio is string
        && request.resource.data.horaFim is string
        && classificacaoJornadaEscalaValida()
        && request.resource.data.observacao is string
        && request.resource.data.criadoPor is string
        && request.resource.data.criadoPor.size() > 0
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.atualizadoPor == request.auth.uid
        && request.resource.data.atualizadoEm is timestamp;
    }

    function indisponibilidadeEscalaValida() {
      return request.resource.data.keys().hasOnly([
          'dataInicio',
          'dataFim',
          'membroEquipeId',
          'usuarioId',
          'nomeSnapshot',
          'tipoId',
          'turnoId',
          'horaInicio',
          'horaFim',
          'observacao',
          'criadoPor',
          'criadoEm',
          'atualizadoPor',
          'atualizadoEm'
        ])
        && request.resource.data.dataInicio is timestamp
        && request.resource.data.dataFim is timestamp
        && request.resource.data.dataFim >= request.resource.data.dataInicio
        && membroEquipeCompativelComUsuario(
          request.resource.data.membroEquipeId,
          request.resource.data.usuarioId
        )
        && request.resource.data.nomeSnapshot is string
        && request.resource.data.nomeSnapshot.size() > 0
        && request.resource.data.tipoId is string
        && request.resource.data.tipoId.size() > 0
        && request.resource.data.turnoId is string
        && request.resource.data.horaInicio is string
        && request.resource.data.horaFim is string
        && request.resource.data.observacao is string
        && request.resource.data.criadoPor is string
        && request.resource.data.criadoPor.size() > 0
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.atualizadoPor == request.auth.uid
        && request.resource.data.atualizadoEm is timestamp;
    }

    function caminhoAtividadeEscala(atividadeId) {
      return /databases/$(database)/documents/escala_atividades/$(atividadeId);
    }

    function podeRegistrarExecucaoMissao(atividadeId) {
      let caminho = caminhoAtividadeEscala(atividadeId);
      return usuarioEscalaAtivo()
        && atividadeId is string
        && atividadeId.size() > 0
        && exists(caminho)
        && get(caminho).data.naturezaAtividade == 'administrativa'
        && get(caminho).data.geraRae == false
        && (
          get(caminho).data.coordenadorUsuarioId == request.auth.uid
          || request.auth.uid in get(caminho).data.participanteUsuarioIds
        );
    }

    function execucaoMissaoValida() {
      return request.resource.data.keys().hasOnly([
          'escalaAtividadeId',
          'escalaId',
          'data',
          'status',
          'resultadoResumo',
          'observacao',
          'evidencias',
          'executadoPorUsuarioId',
          'executadoPorMembroEquipeId',
          'executadoPorNomeSnapshot',
          'concluidoEm',
          'criadoEm',
          'atualizadoEm'
        ])
        && request.resource.data.escalaAtividadeId is string
        && request.resource.data.escalaId is string
        && request.resource.data.escalaId.size() > 0
        && request.resource.data.data is timestamp
        && request.resource.data.status in ['em_execucao', 'concluida', 'cancelada']
        && request.resource.data.resultadoResumo is string
        && request.resource.data.observacao is string
        && request.resource.data.evidencias is list
        && request.resource.data.evidencias.size() <= 20
        && request.resource.data.executadoPorUsuarioId == request.auth.uid
        && request.resource.data.executadoPorMembroEquipeId is string
        && request.resource.data.executadoPorMembroEquipeId.size() > 0
        && membroEquipeCompativelComUsuario(
          request.resource.data.executadoPorMembroEquipeId,
          request.auth.uid
        )
        && request.resource.data.executadoPorNomeSnapshot is string
        && request.resource.data.executadoPorNomeSnapshot.size() > 0
        && (
          request.resource.data.concluidoEm == null
          || request.resource.data.concluidoEm is timestamp
        )
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.atualizadoEm is timestamp
        && (
          request.resource.data.status != 'concluida'
          || (
            request.resource.data.resultadoResumo.size() > 0
            && request.resource.data.concluidoEm is timestamp
          )
        )
        && podeRegistrarExecucaoMissao(
          request.resource.data.escalaAtividadeId
        );
    }

    match /usuarios/{usuarioId} {
      // A leitura do próprio documento precisa funcionar mesmo para conta
      // inativa, permitindo que o cliente determine o estado da identidade.
      allow get: if autenticado() && request.auth.uid == usuarioId;
      allow list: if administrador();

      // O fluxo administrativo altera somente o escopo. Perfil, situação
      // ativa e demais dados de identidade permanecem imutáveis no aplicativo.
      allow update: if administrador()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'escopoAcesso',
          'scopeUpdatedAt',
          'scopeUpdatedBy'
        ])
        && escopoAcessoValido();
      allow create, delete: if false;
    }

    match /domains/{domainId} {
      allow get, list: if usuarioAtivo();
      allow create: if administradorOuGestor()
        && domainValido();
      allow update: if administradorOuGestor()
        && domainValido()
        && createdAtPreservadoOuRegularizado();
      allow delete: if false;
    }

    match /tipos_acoes/{tipoAcaoId} {
      allow get, list: if usuarioAtivo();
      allow create, update: if administradorOuGestor();
      allow delete: if false;
    }

    match /coordenadores/{coordenadorId} {
      allow get, list: if usuarioAtivo();
      allow create, update: if administrador();
      allow delete: if false;
    }

    match /equipe_operacional/{membroId} {
      // Excecao de leitura estritamente necessaria a Gestao da Escala.
      // Nao altera perfilReconhecido()/usuarioAtivo() nem libera escrita.
      allow get, list: if usuarioAtivo() || gerenteEscala();
      allow create: if administrador() && membroEquipeValido();
      allow update: if administrador()
        && membroEquipeValido()
        && createdAtPreservadoOuRegularizado();
      allow delete: if false;
    }

    match /regionais/{regionalId} {
      allow get, list: if usuarioAtivo();
      allow create, update: if administrador();
      allow delete: if false;
    }

    match /equipes/{equipeId} {
      allow get, list: if usuarioAtivo();
      allow create, update: if administrador() && equipeValida();
      allow delete: if false;
    }

    match /projetos/{projetoId} {
      allow get, list: if usuarioAtivo();
      allow create, update: if administrador() && projetoValido();
      allow delete: if false;
    }

    match /materiais/{materialId} {
      allow get, list: if usuarioAtivo();
      allow create, update: if administrador();
      allow delete: if false;
    }

    match /acoes/{acaoId} {
      allow get, list, create, update: if usuarioAtivo();
      allow delete: if administrador();
    }

    match /contadores/{contadorId} {
      allow get, create, update: if usuarioAtivo();
      allow list, delete: if false;
    }

    // ESC-001C - Escala GEDUC
    match /escala_configuracoes/{configId} {
      allow get, list: if usuarioEscalaAtivo();
      allow create, update: if configId == 'principal'
        && podeDesignarResponsavelEscala()
        && configuracaoEscalaValida();
      allow delete: if false;
    }

    match /escala_perfis_operacionais/{perfilId} {
      allow get, list: if usuarioEscalaAtivo();
      allow create: if podeDesignarResponsavelEscala()
        && perfilOperacionalEscalaValido()
        && request.resource.data.criadoPor == request.auth.uid;
      allow update: if podeDesignarResponsavelEscala()
        && perfilOperacionalEscalaValido()
        && request.resource.data.criadoPor == resource.data.criadoPor
        && request.resource.data.criadoEm == resource.data.criadoEm;
      allow delete: if false;
    }

    match /escalas/{escalaId} {
      allow get, list: if usuarioEscalaAtivo();
      allow create: if podeCriarEscala() && criacaoEscalaValida();
      allow update: if podeAtualizarEscala() && atualizacaoEscalaValida();
      allow delete: if false;
    }

    match /escala_atividades/{atividadeId} {
      allow get, list: if usuarioEscalaAtivo();
      allow create: if podeAtualizarEscala()
        && escalaRascunhoPorId(request.resource.data.escalaId)
        && atividadeEscalaValida()
        && request.resource.data.criadoPor == request.auth.uid;
      allow update: if podeAtualizarEscala()
        && escalaRascunhoPorId(request.resource.data.escalaId)
        && atividadeEscalaValida()
        && request.resource.data.escalaId == resource.data.escalaId
        && request.resource.data.data == resource.data.data
        && request.resource.data.criadoPor == resource.data.criadoPor
        && request.resource.data.criadoEm == resource.data.criadoEm;
      allow delete: if false;
    }

    match /escala_alocacoes/{alocacaoId} {
      allow get, list: if usuarioEscalaAtivo();
      allow create: if podeAtualizarEscala()
        && escalaRascunhoPorId(request.resource.data.escalaId)
        && alocacaoEscalaValida()
        && criacaoClassificacaoJornadaEscalaValida()
        && request.resource.data.criadoPor == request.auth.uid;
      allow update: if podeAtualizarEscala()
        && escalaRascunhoPorId(request.resource.data.escalaId)
        && alocacaoEscalaValida()
        && atualizacaoClassificacaoJornadaEscalaValida()
        && request.resource.data.escalaId == resource.data.escalaId
        && request.resource.data.atividadeId == resource.data.atividadeId
        && request.resource.data.membroEquipeId == resource.data.membroEquipeId
        && request.resource.data.criadoPor == resource.data.criadoPor
        && request.resource.data.criadoEm == resource.data.criadoEm;
      allow delete: if podeAtualizarEscala()
        && escalaRascunhoPorId(resource.data.escalaId);
    }

    match /escala_indisponibilidades/{indisponibilidadeId} {
      allow get, list: if usuarioEscalaAtivo();
      allow create: if podeAtualizarEscala()
        && indisponibilidadeEscalaValida()
        && request.resource.data.criadoPor == request.auth.uid;
      allow update: if podeAtualizarEscala()
        && indisponibilidadeEscalaValida()
        && request.resource.data.membroEquipeId == resource.data.membroEquipeId
        && request.resource.data.criadoPor == resource.data.criadoPor
        && request.resource.data.criadoEm == resource.data.criadoEm;
      allow delete: if false;
    }

    match /escala_execucoes_missao/{execucaoId} {
      allow get, list: if usuarioEscalaAtivo();
      allow create: if execucaoMissaoValida();
      allow update: if execucaoMissaoValida()
        && request.resource.data.escalaAtividadeId
          == resource.data.escalaAtividadeId
        && request.resource.data.escalaId == resource.data.escalaId
        && request.resource.data.data == resource.data.data
        && request.resource.data.executadoPorUsuarioId
          == resource.data.executadoPorUsuarioId
        && request.resource.data.executadoPorMembroEquipeId
          == resource.data.executadoPorMembroEquipeId
        && request.resource.data.criadoEm == resource.data.criadoEm;
      allow delete: if false;
    }

    // Toda coleção não inventariada permanece explicitamente bloqueada.
    // MIG-001E2 - migration collections are server-only.
    // Flutter/Web clients have no access during migration.
    match /migration_google_forms_staging/{recordId} {
      allow read, write: if false;
    }

    match /migration_batches/{batchId} {
      allow read, write: if false;

      match /changes/{changeId} {
        allow read, write: if false;
      }
    }

    match /acoes_historicas/{historicalId} {
      allow read, write: if false;
    }
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
