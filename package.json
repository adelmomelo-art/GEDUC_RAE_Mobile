{
  "name": "geduc-rae-firestore-rules-tests",
  "private": true,
  "scripts": {
    "audit:security": "npm audit --audit-level=high",
    "audit:scripts": "npm approve-scripts --allow-scripts-pending",
    "test:rules": "firebase emulators:exec --only firestore --project geduc-rae-mobile-test \"node --test test/firestore.rules.test.js test/firestore_escala.rules.test.js\"",
    "test:rules:acl-stage4a": "firebase emulators:exec --only firestore --project geduc-rae-acl001-stage4a-test \"node --test test/firestore_acl001_stage4a.rules.test.js\"",
    "test:migration:mig001e3": "node --test test/mig001e3_importer.test.mjs test/mig001e3_firestore_rest.test.mjs",
    "test:migration:mig001e4": "node --test test/mig001e4_pilot.test.mjs",
    "test:migration:mig001e5": "node --test test/mig001e5_recovery.test.mjs",
    "test:migration:mig001e6": "node --test test/mig001e6_full_load.test.mjs"
  },
  "allowScripts": {
    "@firebase/util@1.12.1": true,
    "fsevents": false,
    "protobufjs@7.6.5": true,
    "re2@1.26.1": true
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase-tools": "^15.30.0"
  },
  "overrides": {
    "fast-uri": "3.1.7",
    "js-yaml": "4.3.2"
  }
}
