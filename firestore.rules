rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function caminhoUsuarioAtual() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function usuarioExiste() {
      return autenticado() && exists(caminhoUsuarioAtual());
    }

    function usuarioAtual() {
      return get(caminhoUsuarioAtual());
    }

    function perfilAtual() {
      return usuarioAtual().data.perfilAcesso;
    }

    function perfilReconhecido() {
      return usuarioExiste()
        && usuarioAtual().data.perfilAcesso is string
        && perfilAtual() in [
          'administrador',
          'gestor',
          'coordenador',
          'agente'
        ];
    }

    function usuarioAtivo() {
      return perfilReconhecido()
        && usuarioAtual().data.ativo == true;
    }

    function possuiPerfil(perfis) {
      return usuarioAtivo() && perfilAtual() in perfis;
    }

    function administrador() {
      return possuiPerfil(['administrador']);
    }

    function administradorOuGestor() {
      return possuiPerfil(['administrador', 'gestor']);
    }

    function domainValido() {
      return request.resource.data.keys().hasAll([
          'grupo',
          'codigo',
          'nome',
          'ordem',
          'ativo',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.grupo is string
        && request.resource.data.grupo.size() > 0
        && request.resource.data.codigo is string
        && request.resource.data.codigo.size() > 0
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.ordem is int
        && request.resource.data.ativo is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function createdAtPreservadoOuRegularizado() {
      return (
          resource.data.keys().hasAll(['createdAt'])
          && resource.data.createdAt is timestamp
          && request.resource.data.createdAt == resource.data.createdAt
        ) || (
          !resource.data.keys().hasAll(['createdAt'])
          && request.resource.data.createdAt
            == request.resource.data.updatedAt
        );
    }

    function membroEquipeValido() {
      return request.resource.data.keys().hasAll([
          'usuarioId',
          'nome',
          'vinculo',
          'podeCoordenar',
          'ativo',
          'origem',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.usuarioId is string
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.vinculo in ['agente', 'terceirizado']
        && request.resource.data.podeCoordenar is bool
        && request.resource.data.ativo is bool
        && request.resource.data.origem is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function escopoAcessoValido() {
      return request.resource.data.keys().hasAll([
          'escopoAcesso',
          'scopeUpdatedAt',
          'scopeUpdatedBy'
        ])
        && request.resource.data.escopoAcesso is map
        && request.resource.data.escopoAcesso.keys().hasOnly([
          'regionalIds',
          'equipeIds',
          'projetoIds',
          'scopeVersion'
        ])
        && request.resource.data.escopoAcesso.keys().hasAll([
          'regionalIds',
          'equipeIds',
          'projetoIds',
          'scopeVersion'
        ])
        && request.resource.data.escopoAcesso.regionalIds is list
        && request.resource.data.escopoAcesso.equipeIds is list
        && request.resource.data.escopoAcesso.projetoIds is list
        && request.resource.data.escopoAcesso.scopeVersion is int
        && request.resource.data.escopoAcesso.scopeVersion > 0
        && request.resource.data.scopeUpdatedAt is timestamp
        && request.resource.data.scopeUpdatedBy == request.auth.uid;
    }

    function perfilConviteValido(perfil) {
      return perfil in ['gestor', 'gerente', 'coordenador', 'agente'];
    }

    function conviteUsuarioValido() {
      return request.resource.data.keys().hasOnly([
          'nome', 'email', 'telefone', 'cargo', 'setor', 'perfilAcesso',
          'status', 'criadoPor', 'criadoEm', 'atualizadoEm', 'expiraEm',
          'usuarioId'
        ])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.telefone is string
        && request.resource.data.cargo is string
        && request.resource.data.setor is string
        && perfilConviteValido(request.resource.data.perfilAcesso)
        && request.resource.data.status == 'pendente'
        && request.resource.data.criadoPor == request.auth.uid
        && request.resource.data.criadoEm == request.time
        && request.resource.data.atualizadoEm == request.time
        && request.resource.data.expiraEm is timestamp
        && request.resource.data.expiraEm > request.time
        && request.resource.data.usuarioId == '';
    }

    function identidadeConfirmadaParaConvite(convite) {
      return autenticado()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.email == convite.email;
    }

    function conviteConsumidoPeloUsuario(conviteId, usuarioId) {
      let caminho = /databases/$(database)/documents/convites_usuarios/$(conviteId);
      return exists(caminho)
        && get(caminho).data.status == 'pendente'
        && get(caminho).data.expiraEm > request.time
        && identidadeConfirmadaParaConvite(get(caminho).data)
        && getAfter(caminho).data.status == 'utilizado'
        && getAfter(caminho).data.usuarioId == usuarioId;
    }

    function novoUsuarioPorConviteValido(usuarioId) {
      let conviteId = request.resource.data.conviteId;
      let convite = get(
        /databases/$(database)/documents/convites_usuarios/$(conviteId)
      ).data;
      return request.resource.data.keys().hasOnly([
          'nome', 'email', 'telefone', 'cargo', 'setor', 'perfilAcesso',
          'ativo', 'dataCriacao', 'ultimoAcesso', 'escopoAcesso', 'conviteId'
        ])
        && request.resource.data.nome == convite.nome
        && request.resource.data.email == convite.email
        && request.resource.data.telefone == convite.telefone
        && request.resource.data.cargo == convite.cargo
        && request.resource.data.setor == convite.setor
        && request.resource.data.perfilAcesso == convite.perfilAcesso
        && request.resource.data.ativo == false
        && request.resource.data.dataCriacao == request.time
        && request.resource.data.ultimoAcesso == null
        && request.resource.data.escopoAcesso == {
          'regionalIds': [],
          'equipeIds': [],
          'projetoIds': [],
          'scopeVersion': 1
        }
        && request.auth.uid == usuarioId
        && conviteConsumidoPeloUsuario(conviteId, usuarioId);
    }

    function novoMembroPorConviteValido(membroId) {
      let usuarioDepois = getAfter(
        /databases/$(database)/documents/usuarios/$(request.auth.uid)
      ).data;
      let convite = get(
        /databases/$(database)/documents/convites_usuarios/$(usuarioDepois.conviteId)
      ).data;
      return membroId == request.auth.uid
        && convite.perfilAcesso in ['agente', 'coordenador']
        && request.resource.data.keys().hasOnly([
          'usuarioId', 'nome', 'vinculo', 'podeCoordenar', 'ativo',
          'origem', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.nome == convite.nome
        && request.resource.data.vinculo == 'agente'
        && request.resource.data.podeCoordenar
          == (convite.perfilAcesso == 'coordenador')
        && request.resource.data.ativo == false
        && request.resource.data.origem == 'convite'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && conviteConsumidoPeloUsuario(usuarioDepois.conviteId, request.auth.uid);
    }

    function usuarioProntoParaAtivacao(usuarioId) {
      let perfil = resource.data.perfilAcesso;
      let membro = /databases/$(database)/documents/equipe_operacional/$(usuarioId);
      return (
          perfil in ['agente', 'coordenador']
          && exists(membro)
          && get(membro).data.usuarioId == usuarioId
          && get(membro).data.ativo == true
        ) || (
          perfil == 'gerente'
          && resource.data.escopoAcesso.regionalIds.size() > 0
          && resource.data.escopoAcesso.equipeIds.size() > 0
          && resource.data.escopoAcesso.projetoIds.size() > 0
        ) || perfil == 'gestor';
    }

    function equipeValida() {
      return request.resource.data.keys().hasAll([
          'nome',
          'codigo',
          'regionalIds',
          'membroIds',
          'coordenadorUserIds',
          'ativo'
        ])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.codigo is string
        && request.resource.data.regionalIds is list
        && request.resource.data.membroIds is list
        && request.resource.data.coordenadorUserIds is list
        && request.resource.data.ativo is bool;
    }

    function projetoValido() {
      return request.resource.data.keys().hasAll([
          'nome',
          'codigo',
          'categoria',
          'descricao',
          'objetivo',
          'publicoAlvo',
          'palavrasChave',
          'aliases',
          'regionalIds',
          'equipeIds',
          'ordem',
          'ativo'
        ])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.codigo is string
        && request.resource.data.codigo.size() > 0
        && request.resource.data.categoria is string
        && request.resource.data.categoria.size() > 0
        && request.resource.data.descricao is string
        && request.resource.data.objetivo is string
        && request.resource.data.publicoAlvo is string
        && request.resource.data.palavrasChave is list
        && request.resource.data.aliases is list
        // Compatibilidade legada. Listas vazias sao validas e nao
        // representam vinculo operacional obrigatorio do RAE.
        && request.resource.data.regionalIds is list
        && request.resource.data.equipeIds is list
        && request.resource.data.ordem is int
        && request.resource.data.ordem >= 0
        && request.resource.data.ativo is bool;
    }

    // ESC-001C - Autorização isolada do módulo Escala.
    // Não reutiliza usuarioAtivo() para o Gerente, evitando ampliar o ACL
    // legado de RAE e demais coleções.
    function perfilEscalaAtual() {
      return usuarioAtual().data.perfilAcesso;
    }

    function usuarioEscalaAtivo() {
      return usuarioExiste()
        && usuarioAtual().data.ativo == true
        && usuarioAtual().data.perfilAcesso is string
        && perfilEscalaAtual() in [
          'administrador',
          'gestor',
          'gerente',
          'coordenador',
          'agente'
        ];
    }

    function administradorEscala() {
      return usuarioEscalaAtivo()
        && perfilEscalaAtual() == 'administrador';
    }

    function gerenteEscala() {
      return usuarioEscalaAtivo()
        && perfilEscalaAtual() == 'gerente';
    }

    function caminhoConfiguracaoEscala() {
      return /databases/$(database)/documents/escala_configuracoes/principal;
    }

    function responsavelEscalaAtivo() {
      return usuarioEscalaAtivo()
        && perfilEscalaAtual() == 'agente'
        && exists(caminhoConfiguracaoEscala())
        && get(caminhoConfiguracaoEscala()).data.ativo == true
        && get(caminhoConfiguracaoEscala()).data.responsavelEscalaUsuarioId
          == request.auth.uid;
    }

    function podeCriarEscala() {
      return responsavelEscalaAtivo();
    }

    function podeAtualizarEscala() {
      // A mesma política, com identidade avaliada uma única vez.
      let usuario = usuarioExiste() ? usuarioAtual().data : {};
      let perfil = usuario.get('perfilAcesso', '');
      return usuario.get('ativo', false) == true && (
        perfil == 'gerente' || (
          perfil == 'agente'
          && exists(caminhoConfiguracaoEscala())
          && get(caminhoConfiguracaoEscala()).data.ativo == true
          && get(caminhoConfiguracaoEscala()).data.responsavelEscalaUsuarioId == request.auth.uid
        )
      );
    }

    function escalaRascunhoPorId(escalaId) {
      return escalaId is string
        && escalaId.size() > 0
        && existsAfter(/databases/$(database)/documents/escalas/$(escalaId))
        && getAfter(/databases/$(database)/documents/escalas/$(escalaId)).data.status == 'rascunho';
    }

    function escalaPublicadaPorId(escalaId) {
      return escalaId is string
        && escalaId.size() > 0
        && exists(/databases/$(database)/documents/escalas/$(escalaId))
        && get(/databases/$(database)/documents/escalas/$(escalaId)).data.status == 'publicada';
    }

    function podeDesignarResponsavelEscala() {
      return administradorEscala() || gerenteEscala();
    }

    function caminhoMembroEquipe(membroId) {
      return /databases/$(database)/documents/equipe_operacional/$(membroId);
    }

    function membroEquipeAtivo(membroId) {
      return membroId is string
        && membroId.size() > 0
        && exists(caminhoMembroEquipe(membroId))
        && get(caminhoMembroEquipe(membroId)).data.ativo == true;
    }

    function membroEquipeCompativelComUsuario(membroId, usuarioId) {
      return membroEquipeAtivo(membroId)
        && usuarioId is string
        && (
          usuarioId.size() == 0
          || get(caminhoMembroEquipe(membroId)).data.usuarioId == usuarioId
        );
    }

    function responsavelEscalaValido() {
      let uid = request.resource.data.responsavelEscalaUsuarioId;
      let membroId = request.resource.data.responsavelEscalaMembroEquipeId;
      let caminho = /databases/$(database)/documents/usuarios/$(uid);
      return uid is string
        && uid.size() > 0
        && membroId is string
        && membroId.size() > 0
        && exists(caminho)
        && get(caminho).data.ativo == true
        && get(caminho).data.perfilAcesso == 'agente'
        && membroEquipeAtivo(membroId)
        && get(caminhoMembroEquipe(membroId)).data.usuarioId == uid;
    }

    function configuracaoEscalaValida() {
      return request.resource.data.keys().hasOnly([
          'responsavelEscalaUsuarioId',
          'responsavelEscalaMembroEquipeId',
          'ativo',
          'designadoPor',
          'designadoEm'
        ])
        && request.resource.data.responsavelEscalaUsuarioId is string
        && request.resource.data.responsavelEscalaMembroEquipeId is string
        && request.resource.data.ativo is bool
        && request.resource.data.designadoPor == request.auth.uid
        && request.resource.data.designadoEm is timestamp
        && responsavelEscalaValido();
    }

    function perfilOperacionalEscalaValido() {
      return request.resource.data.keys().hasOnly([
          'membroEquipeId',
          'usuarioId',
          'setorCodigo',
          'cargaHorariaCodigo',
          'ativo',
          'criadoPor',
          'criadoEm',
          'atualizadoPor',
          'atualizadoEm'
        ])
        && request.resource.data.membroEquipeId is string
        && request.resource.data.usuarioId is string
        && request.resource.data.setorCodigo is string
        && request.resource.data.setorCodigo.size() > 0
        && request.resource.data.cargaHorariaCodigo is string
        && request.resource.data.cargaHorariaCodigo.size() > 0
        && request.resource.data.ativo is bool
        && request.resource.data.criadoPor is string
        && request.resource.data.criadoPor.size() > 0
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.atualizadoPor == request.auth.uid
        && request.resource.data.atualizadoEm is timestamp
        && membroEquipeCompativelComUsuario(
          request.resource.data.membroEquipeId,
          request.resource.data.usuarioId
        );
    }

    function escalaValida() {
      return request.resource.data.keys().hasOnly([
          'data',
          'status',
          'versao',
          'observacaoGeral',
          'motivoRevisao',
          'revisaoDeEscalaId',
          'revisaoPreparada',
          'criadoPor',
          'criadoEm',
          'atualizadoPor',
          'atualizadoEm',
          'publicadoPor',
          'publicadoEm'
        ])
        && request.resource.data.data is timestamp
        && request.resource.data.status in ['rascunho', 'publicada', 'arquivada']
        && request.resource.data.versao is int
        && request.resource.data.versao > 0
        && request.resource.data.observacaoGeral is string
        && request.resource.data.motivoRevisao is string
        && (
          !('revisaoDeEscalaId' in request.resource.data)
          || request.resource.data.revisaoDeEscalaId is string
        )
        && (
          !('revisaoPreparada' in request.resource.data)
          || request.resource.data.revisaoPreparada is bool
        )
        && request.resource.data.criadoPor is string
        && request.resource.data.criadoPor.size() > 0
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.atualizadoPor == request.auth.uid
        && request.resource.data.atualizadoEm is timestamp
        && request.resource.data.publicadoPor is string
        && (
          request.resource.data.publicadoEm == null
          || request.resource.data.publicadoEm is timestamp
        )
        && (
          (
            request.resource.data.status == 'rascunho'
            && request.resource.data.publicadoPor.size() == 0
            && request.resource.data.publicadoEm == null
          )
          || (
            request.resource.data.status in ['publicada', 'arquivada']
            && request.resource.data.publicadoPor.size() > 0
            && request.resource.data.publicadoEm is timestamp
          )
        );
    }

    function revisaoDeEscalaIdAtual() {
      return 'revisaoDeEscalaId' in request.resource.data
        ? request.resource.data.revisaoDeEscalaId
        : '';
    }

    function revisaoDeEscalaIdAnterior() {
      return 'revisaoDeEscalaId' in resource.data
        ? resource.data.revisaoDeEscalaId
        : '';
    }

    function revisaoPreparadaAtual() {
      return 'revisaoPreparada' in request.resource.data
        ? request.resource.data.revisaoPreparada
        : true;
    }

    function criacaoEscalaInicialValida() {
      return escalaValida()
        && request.resource.data.status == 'rascunho'
        && request.resource.data.versao == 1
        && revisaoDeEscalaIdAtual().size() == 0
        && revisaoPreparadaAtual() == true
        && request.resource.data.criadoPor == request.auth.uid;
    }

    function criacaoRevisaoEscalaValida() {
      let origemId = revisaoDeEscalaIdAtual();
      let caminhoOrigem =
        /databases/$(database)/documents/escalas/$(origemId);
      return escalaValida()
        && request.resource.data.status == 'rascunho'
        && request.resource.data.versao > 1
        && request.resource.data.motivoRevisao.size() > 0
        && origemId.size() > 0
        && 'revisaoPreparada' in request.resource.data
        && request.resource.data.revisaoPreparada == false
        && request.resource.data.criadoPor == request.auth.uid
        && exists(caminhoOrigem)
        && get(caminhoOrigem).data.status == 'publicada'
        && get(caminhoOrigem).data.data == request.resource.data.data
        && request.resource.data.versao
          == get(caminhoOrigem).data.versao + 1;
    }

    function atualizacaoEscalaValida() {
      return escalaValida()
        && request.resource.data.data == resource.data.data
        && request.resource.data.criadoPor == resource.data.criadoPor
        && request.resource.data.criadoEm == resource.data.criadoEm
        && revisaoDeEscalaIdAtual() == revisaoDeEscalaIdAnterior()
        && resource.data.status != 'arquivada'
        && (
          (
            resource.data.status == 'rascunho'
            && request.resource.data.status in ['rascunho', 'publicada']
            && request.resource.data.versao == resource.data.versao
            && (
              request.resource.data.versao == 1
              || (
                request.resource.data.motivoRevisao.size() > 0
                && request.resource.data.motivoRevisao
                  == resource.data.motivoRevisao
                && revisaoDeEscalaIdAtual().size() > 0
              )
            )
          )
          || (
            resource.data.status == 'publicada'
            && request.resource.data.status == 'arquivada'
            && request.resource.data.versao == resource.data.versao
            && request.resource.data.observacaoGeral
              == resource.data.observacaoGeral
            && request.resource.data.motivoRevisao
              == resource.data.motivoRevisao
            && request.resource.data.publicadoPor
              == resource.data.publicadoPor
            && request.resource.data.publicadoEm
              == resource.data.publicadoEm
          )
        )
        && (
          request.resource.data.status != 'publicada'
          || (
            request.resource.data.publicadoPor == request.auth.uid
            && request.resource.data.publicadoEm is timestamp
            && (
              request.resource.data.versao == 1
              || revisaoPreparadaAtual() == true
            )
          )
        );
    }

    function coordenadorAtividadeValido() {
      let membroId = request.resource.data.coordenadorMembroEquipeId;
      let usuarioId = request.resource.data.coordenadorUsuarioId;
      return (
          membroId.size() == 0
          && usuarioId.size() == 0
          && request.resource.data.coordenadorNomeSnapshot.size() == 0
        ) || (
          membroEquipeAtivo(membroId)
          && get(caminhoMembroEquipe(membroId)).data.podeCoordenar == true
          && (
            usuarioId.size() == 0
            || get(caminhoMembroEquipe(membroId)).data.usuarioId == usuarioId
          )
          && request.resource.data.coordenadorNomeSnapshot.size() > 0
        );
    }

    // AGO-001: a agenda permanece privada; a escala recebe apenas um snapshot operacional.
    function caminhoAgenda(id) {
      return /databases/$(database)/documents/agenda_operacional/$(id);
    }

    function agendaValida() {
      let d = request.resource.data;
      return d.keys().hasOnly([
        'data', 'titulo', 'turno', 'instituicao', 'projetoId', 'natureza', 'secaoId',
        'horaInicio', 'horaFim', 'local', 'endereco', 'bairro', 'regionalId', 'referencia',
        'contatoNome', 'contatoTelefone', 'descricao', 'publico', 'quantidadePublico',
        'integrantesNecessarios', 'materiais', 'observacoesInternas', 'orientacaoEquipe',
        'origem', 'processo', 'situacao', 'motivo', 'revisao', 'escalaId', 'atividadeId',
        'dataVinculada', 'criadoPor', 'criadoEm', 'atualizadoPor', 'atualizadoEm'
      ])
      && d.keys().hasAll([
        'data', 'titulo', 'turno', 'instituicao', 'projetoId', 'natureza', 'secaoId',
        'horaInicio', 'horaFim', 'local', 'endereco', 'bairro', 'regionalId', 'referencia',
        'contatoNome', 'contatoTelefone', 'descricao', 'publico', 'quantidadePublico',
        'integrantesNecessarios', 'materiais', 'observacoesInternas', 'orientacaoEquipe',
        'origem', 'processo', 'situacao', 'motivo', 'revisao', 'escalaId', 'atividadeId',
        'dataVinculada', 'criadoPor', 'criadoEm', 'atualizadoPor', 'atualizadoEm'
      ])
      && d.data is timestamp && d.titulo is string && d.titulo.size() > 0 && d.titulo.size() <= 4000
      && d.turno in ['manha', 'tarde', 'noite'] && d.natureza in ['educativa', 'administrativa']
      && d.secaoId is string && d.secaoId.size() > 0
      && d.instituicao is string && d.projetoId is string && d.local is string && d.endereco is string
      && d.bairro is string && d.regionalId is string && d.referencia is string
      && d.contatoNome is string && d.contatoTelefone is string
      && d.descricao is string && d.publico is string && d.materiais is string
      && d.observacoesInternas is string && d.orientacaoEquipe is string
      && d.processo is string && d.motivo is string
      && d.origem in ['contato_direto', 'processo', 'chefia']
      && d.situacao in ['planejamento', 'pronta', 'cancelada']
      && (d.situacao != 'cancelada' || d.motivo.size() > 0)
      && d.horaInicio is string && d.horaFim is string
      && ((d.horaInicio == '' && d.horaFim == '') ||
        (horarioRealEscalaValido(d.horaInicio) && horarioRealEscalaValido(d.horaFim)))
      && (d.quantidadePublico == null || (d.quantidadePublico is int && d.quantidadePublico >= 0))
      && (d.integrantesNecessarios == null || (d.integrantesNecessarios is int && d.integrantesNecessarios >= 0))
      && d.revisao is int && d.revisao > 0
      && d.escalaId is string && d.atividadeId is string
      && ((d.escalaId == '' && d.atividadeId == '' && d.dataVinculada == null) ||
        (d.escalaId.size() > 0 && d.atividadeId.size() > 0 && d.dataVinculada is timestamp))
      && d.criadoPor is string && d.criadoEm is timestamp
      && d.atualizadoPor == request.auth.uid && d.atualizadoEm == request.time;
    }

    function agendaTemHistorico(id) {
      let caminho = /databases/$(database)/documents/agenda_operacional/$(id)/historico/$(string(request.resource.data.revisao));
      return existsAfter(caminho)
        && getAfter(caminho).data.revisao == request.resource.data.revisao
        && getAfter(caminho).data.usuarioId == request.auth.uid
        && getAfter(caminho).data.em == request.time;
    }

    function agendaVinculoDepoisValido(id) {
      let d = request.resource.data;
      let atividade = /databases/$(database)/documents/escala_atividades/$(d.atividadeId);
      return d.atividadeId == '' || (existsAfter(atividade)
        && getAfter(atividade).data.agendaCompromissoId == id
        && getAfter(atividade).data.escalaId == d.escalaId);
    }

    function atividadeAgendaCamposValidos() {
      let d = request.resource.data;
      return (!('projetoId' in d) || d.projetoId is string)
        && (!('agendaCompromissoId' in d) ||
          (d.agendaCompromissoId is string && d.agendaCompromissoId.size() > 0
            && d.agendaRevisao is int && d.agendaRevisao > 0
            && (!('agendaOrigemAtividadeId' in d) || d.agendaOrigemAtividadeId is string)));
    }

    function atividadeAgendaVinculoValido(atividadeId) {
      let d = request.resource.data;
      let origem = 'agendaOrigemAtividadeId' in d ? d.agendaOrigemAtividadeId : '';
      let caminhoOrigem = /databases/$(database)/documents/escala_atividades/$(origem);
      let escalaDestino = /databases/$(database)/documents/escalas/$(d.escalaId);
      // A cópia da publicação é validada pela origem antes de consultar a
      // agenda privada. Evita repetir autorizações no caminho quente da revisão.
      return !('agendaCompromissoId' in d) || (
        origem.size() > 0 && exists(caminhoOrigem)
        && get(caminhoOrigem).data.agendaCompromissoId == d.agendaCompromissoId
        && get(caminhoOrigem).data.agendaRevisao == d.agendaRevisao
        && getAfter(escalaDestino).data.revisaoDeEscalaId == get(caminhoOrigem).data.escalaId
      ) || (
        responsavelEscalaAtivo()
        && existsAfter(caminhoAgenda(d.agendaCompromissoId))
        && getAfter(caminhoAgenda(d.agendaCompromissoId)).data.situacao == 'pronta'
        && getAfter(caminhoAgenda(d.agendaCompromissoId)).data.atividadeId == atividadeId
        && getAfter(caminhoAgenda(d.agendaCompromissoId)).data.revisao == d.agendaRevisao
        && getAfter(caminhoAgenda(d.agendaCompromissoId)).data.escalaId == d.escalaId
      );
    }

    function atividadeAgendaOrigemPreservada() {
      let anterior = 'agendaCompromissoId' in resource.data ? resource.data.agendaCompromissoId : '';
      let atual = 'agendaCompromissoId' in request.resource.data ? request.resource.data.agendaCompromissoId : '';
      return anterior == atual && (anterior == '' || (
        request.resource.data.agendaRevisao == resource.data.agendaRevisao || (
          responsavelEscalaAtivo()
          && getAfter(caminhoAgenda(atual)).data.revisao == request.resource.data.agendaRevisao
        )
      ));
    }

    function atividadeEscalaValida() {
      return request.resource.data.keys().hasOnly([
          'agendaCompromissoId', 'agendaRevisao', 'agendaOrigemAtividadeId', 'projetoId',
          'escalaId',
          'data',
          'secaoId',
          'tipoAtividadeId',
          'naturezaAtividade',
          'titulo',
          'descricao',
          'turnoId',
          'qtrHorario',
          'horaInicio',
          'horaFim',
          'qthLocal',
          'qthEndereco',
          'qthRegionalId',
          'qthPontoReferencia',
          'orientacaoOperacional',
          'coordenadorMembroEquipeId',
          'coordenadorUsuarioId',
          'coordenadorNomeSnapshot',
          'participanteUsuarioIds',
          'geraRae',
          'contabilizaProdutividade',
          'raeId',
          'execucaoMissaoId',
          'status',
          'criadoPor',
          'criadoEm',
          'atualizadoPor',
          'atualizadoEm'
        ])
        && request.resource.data.escalaId is string
        && request.resource.data.escalaId.size() > 0
        && request.resource.data.data is timestamp
        && request.resource.data.secaoId is string
        && request.resource.data.tipoAtividadeId is string
        && request.resource.data.tipoAtividadeId.size() > 0
        && request.resource.data.naturezaAtividade in ['educativa', 'administrativa']
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() > 0
        && request.resource.data.descricao is string
        && request.resource.data.turnoId is string
        && request.resource.data.qtrHorario is string
        && request.resource.data.horaInicio is string
        && request.resource.data.horaFim is string
        && request.resource.data.qthLocal is string
        && request.resource.data.qthEndereco is string
        && request.resource.data.qthRegionalId is string
        && request.resource.data.qthPontoReferencia is string
        && request.resource.data.orientacaoOperacional is string
        && request.resource.data.coordenadorMembroEquipeId is string
        && request.resource.data.coordenadorUsuarioId is string
        && request.resource.data.coordenadorNomeSnapshot is string
        && request.resource.data.participanteUsuarioIds is list
        && request.resource.data.geraRae is bool
        && request.resource.data.contabilizaProdutividade is bool
        && request.resource.data.raeId is string
        && request.resource.data.execucaoMissaoId is string
        && request.resource.data.status in [
          'planejada',
          'publicada',
          'em_execucao',
          'concluida',
          'cancelada'
        ]
        && request.resource.data.criadoPor is string
        && request.resource.data.criadoPor.size() > 0
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.atualizadoPor == request.auth.uid
        && request.resource.data.atualizadoEm is timestamp
        && (
          (
            request.resource.data.naturezaAtividade == 'educativa'
            && request.resource.data.geraRae == true
          )
          || (
            request.resource.data.naturezaAtividade == 'administrativa'
            && request.resource.data.geraRae == false
          )
        )
        && coordenadorAtividadeValido()
        && atividadeAgendaCamposValidos();
    }

    function jornadaComplementarEscala() {
      return request.resource.data.tipoJornada in ['hora_extra', 'banco_horas'];
    }

    function classificacaoJornadaEscalaValida() {
      return request.resource.data.tipoJornada in [
          'normal',
          'hora_extra',
          'banco_horas'
        ]
        && request.resource.data.horaInicioReal is string
        && request.resource.data.horaFimReal is string
        && request.resource.data.minutosPrevistos is int
        && request.resource.data.minutosPrevistos >= 0
        && request.resource.data.minutosPrevistos <= 1440
        && (
          request.resource.data.minutosRealizados == null
          || (
            request.resource.data.minutosRealizados is int
            && request.resource.data.minutosRealizados >= 0
            && request.resource.data.minutosRealizados <= 1440
          )
        )
        && request.resource.data.motivoJornadaComplementar is string
        && request.resource.data.classificadoPor is string
        && (
          request.resource.data.classificadoEm == null
          || request.resource.data.classificadoEm is timestamp
        )
        && (
          !jornadaComplementarEscala()
          || (
            request.resource.data.motivoJornadaComplementar.size() > 0
            && request.resource.data.classificadoPor.size() > 0
            && request.resource.data.classificadoEm is timestamp
          )
        );
    }

    function cloneJornadaPublicadaValido() {
      let origemId = request.resource.data.origemAlocacaoId;
      let caminhoOrigem =
        /databases/$(database)/documents/escala_alocacoes/$(origemId);
      let origem = get(caminhoOrigem).data;
      let caminhoEscalaOrigem =
        /databases/$(database)/documents/escalas/$(origem.escalaId);
      return exists(caminhoOrigem)
        && exists(caminhoEscalaOrigem)
        && get(caminhoEscalaOrigem).data.status == 'publicada'
        && origem.membroEquipeId == request.resource.data.membroEquipeId
        && origem.usuarioId == request.resource.data.usuarioId
        && origem.nomeSnapshot == request.resource.data.nomeSnapshot
        && origem.vinculoSnapshot == request.resource.data.vinculoSnapshot
        && origem.setorSnapshot == request.resource.data.setorSnapshot
        && origem.cargaHorariaSnapshot
          == request.resource.data.cargaHorariaSnapshot
        && origem.funcaoNaAtividade
          == request.resource.data.funcaoNaAtividade
        && origem.turnoId == request.resource.data.turnoId
        && origem.horaInicio == request.resource.data.horaInicio
        && origem.horaFim == request.resource.data.horaFim
        && origem.tipoJornada == request.resource.data.tipoJornada
        && origem.horaInicioReal == request.resource.data.horaInicioReal
        && origem.horaFimReal == request.resource.data.horaFimReal
        && origem.minutosPrevistos == request.resource.data.minutosPrevistos
        && origem.minutosRealizados
          == request.resource.data.minutosRealizados
        && origem.motivoJornadaComplementar
          == request.resource.data.motivoJornadaComplementar
        && origem.classificadoPor == request.resource.data.classificadoPor
        && origem.classificadoEm == request.resource.data.classificadoEm
        && origem.observacao == request.resource.data.observacao;
    }

    function criacaoClassificacaoJornadaEscalaValida() {
      return !jornadaComplementarEscala()
        || (
          responsavelEscalaAtivo()
          && request.resource.data.classificadoPor == request.auth.uid
        )
        || (
          'origemAlocacaoId' in request.resource.data
          && request.resource.data.origemAlocacaoId is string
          && request.resource.data.origemAlocacaoId.size() > 0
          && exists(
            /databases/$(database)/documents/escala_alocacoes/$(request.resource.data.origemAlocacaoId)
          )
          && cloneJornadaPublicadaValido()
        );
    }

    function atualizacaoClassificacaoJornadaEscalaValida() {
      let mudou = request.resource.data.tipoJornada != resource.data.tipoJornada
        || request.resource.data.motivoJornadaComplementar
          != resource.data.motivoJornadaComplementar
        || request.resource.data.classificadoPor != resource.data.classificadoPor
        || request.resource.data.classificadoEm != resource.data.classificadoEm;
      return !mudou
        || (
          responsavelEscalaAtivo()
          && request.resource.data.classificadoPor == request.auth.uid
        );
    }

    function horarioRealEscalaValido(valor) {
      return valor is string
        && valor.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function horasReaisNaoRegistradas() {
      return request.resource.data.horaInicioReal == ''
        && request.resource.data.horaFimReal == ''
        && request.resource.data.minutosRealizados == null;
    }

    function horasReaisEscalaValidas() {
      let inicio = request.resource.data.horaInicioReal;
      let fim = request.resource.data.horaFimReal;
      let minutos = request.resource.data.minutosRealizados;
      return (
          inicio == ''
          && fim == ''
          && minutos == null
        ) || (
          horarioRealEscalaValido(inicio)
          && horarioRealEscalaValido(fim)
          && minutos is int
          && minutos >= 0
          && minutos <= 1440
        );
    }

    function atualizacaoPlanejamentoPreservaHorasReais() {
      return request.resource.data.horaInicioReal == resource.data.horaInicioReal
        && request.resource.data.horaFimReal == resource.data.horaFimReal
        && request.resource.data.minutosRealizados == resource.data.minutosRealizados;
    }

    function podeRegistrarHorasRealizadasAlocacao() {
      return usuarioEscalaAtivo()
        && resource.data.usuarioId is string
        && resource.data.usuarioId.size() > 0
        && resource.data.usuarioId == request.auth.uid
        && escalaPublicadaPorId(resource.data.escalaId);
    }

    function atualizacaoHorasRealizadasValida() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'horaInicioReal',
          'horaFimReal',
          'minutosRealizados',
          'observacao',
          'atualizadoPor',
          'atualizadoEm'
        ])
        && request.resource.data.atualizadoPor == request.auth.uid
        && request.resource.data.atualizadoEm is timestamp
        && horasReaisEscalaValidas();
    }

    function alocacaoEscalaValida() {
      return request.resource.data.keys().hasOnly([
          'escalaId',
          'atividadeId',
          'data',
          'membroEquipeId',
          'usuarioId',
          'nomeSnapshot',
          'vinculoSnapshot',
          'setorSnapshot',
          'cargaHorariaSnapshot',
          'funcaoNaAtividade',
          'turnoId',
          'horaInicio',
          'horaFim',
          'tipoJornada',
          'horaInicioReal',
          'horaFimReal',
          'minutosPrevistos',
          'minutosRealizados',
          'motivoJornadaComplementar',
          'classificadoPor',
          'classificadoEm',
          'origemAlocacaoId',
          'observacao',
          'criadoPor',
          'criadoEm',
          'atualizadoPor',
          'atualizadoEm'
        ])
        && request.resource.data.escalaId is string
        && request.resource.data.escalaId.size() > 0
        && request.resource.data.atividadeId is string
        && request.resource.data.atividadeId.size() > 0
        && request.resource.data.data is timestamp
        && membroEquipeCompativelComUsuario(
          request.resource.data.membroEquipeId,
          request.resource.data.usuarioId
        )
        && request.resource.data.nomeSnapshot is string
        && request.resource.data.nomeSnapshot.size() > 0
        && request.resource.data.vinculoSnapshot in ['agente', 'terceirizado']
        && request.resource.data.setorSnapshot is string
        && request.resource.data.cargaHorariaSnapshot is string
        && request.resource.data.funcaoNaAtividade is string
        && request.resource.data.turnoId is string
        && request.resource.data.horaInicio is string
        && request.resource.data.horaFim is string
        && classificacaoJornadaEscalaValida()
        && horasReaisEscalaValidas()
        && (
          !('origemAlocacaoId' in request.resource.data)
          || request.resource.data.origemAlocacaoId is string
        )
        && request.resource.data.observacao is string
        && request.resource.data.criadoPor is string
        && request.resource.data.criadoPor.size() > 0
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.atualizadoPor == request.auth.uid
        && request.resource.data.atualizadoEm is timestamp;
    }

    function indisponibilidadeEscalaValida() {
      return request.resource.data.keys().hasOnly([
          'dataInicio',
          'dataFim',
          'membroEquipeId',
          'usuarioId',
          'nomeSnapshot',
          'tipoId',
          'turnoId',
          'horaInicio',
          'horaFim',
          'observacao',
          'criadoPor',
          'criadoEm',
          'atualizadoPor',
          'atualizadoEm'
        ])
        && request.resource.data.dataInicio is timestamp
        && request.resource.data.dataFim is timestamp
        && request.resource.data.dataFim >= request.resource.data.dataInicio
        && membroEquipeCompativelComUsuario(
          request.resource.data.membroEquipeId,
          request.resource.data.usuarioId
        )
        && request.resource.data.nomeSnapshot is string
        && request.resource.data.nomeSnapshot.size() > 0
        && request.resource.data.tipoId is string
        && request.resource.data.tipoId.size() > 0
        && request.resource.data.turnoId is string
        && request.resource.data.horaInicio is string
        && request.resource.data.horaFim is string
        && request.resource.data.observacao is string
        && request.resource.data.criadoPor is string
        && request.resource.data.criadoPor.size() > 0
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.atualizadoPor == request.auth.uid
        && request.resource.data.atualizadoEm is timestamp;
    }

    function caminhoAtividadeEscala(atividadeId) {
      return /databases/$(database)/documents/escala_atividades/$(atividadeId);
    }

    function caminhoRae(raeId) {
      return /databases/$(database)/documents/acoes/$(raeId);
    }

    function operadorRaeDaAtividade(atividade) {
      return usuarioEscalaAtivo()
        && (
          (
            perfilEscalaAtual() == 'agente'
            && request.auth.uid in atividade.participanteUsuarioIds
          )
          || (
            perfilEscalaAtual() == 'coordenador'
            && (
              atividade.coordenadorUsuarioId == request.auth.uid
              || request.auth.uid in atividade.participanteUsuarioIds
            )
          )
        );
    }

    function vinculacaoRaeAtividadeValida(atividadeId) {
      let raeId = request.resource.data.raeId;
      let caminho = caminhoRae(raeId);
      return resource.data.naturezaAtividade == 'educativa'
        && resource.data.geraRae == true
        && resource.data.status != 'cancelada'
        && escalaPublicadaPorId(resource.data.escalaId)
        && operadorRaeDaAtividade(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'raeId',
          'atualizadoPor',
          'atualizadoEm'
        ])
        && resource.data.raeId == ''
        && raeId is string
        && raeId.size() > 0
        && request.resource.data.atualizadoPor == request.auth.uid
        && request.resource.data.atualizadoEm is timestamp
        && existsAfter(caminho)
        && getAfter(caminho).data.id == raeId
        && getAfter(caminho).data.escalaId == resource.data.escalaId
        && getAfter(caminho).data.escalaAtividadeId == atividadeId
        && getAfter(caminho).data.responsavelUserId == request.auth.uid;
    }

    function criacaoRaeVinculadoValida(acaoId) {
      let possuiEscala = 'escalaId' in request.resource.data
        && request.resource.data.escalaId is string
        && request.resource.data.escalaId.size() > 0;
      let possuiAtividade = 'escalaAtividadeId' in request.resource.data
        && request.resource.data.escalaAtividadeId is string
        && request.resource.data.escalaAtividadeId.size() > 0;
      let atividadeId = possuiAtividade
        ? request.resource.data.escalaAtividadeId
        : '';
      let caminho = caminhoAtividadeEscala(atividadeId);
      return (!possuiEscala && !possuiAtividade)
        || (
          possuiEscala
          && possuiAtividade
          && request.resource.data.id == acaoId
          && request.resource.data.responsavelUserId == request.auth.uid
          && existsAfter(caminho)
          && getAfter(caminho).data.escalaId == request.resource.data.escalaId
          && getAfter(caminho).data.naturezaAtividade == 'educativa'
          && getAfter(caminho).data.geraRae == true
          && getAfter(caminho).data.status != 'cancelada'
          && getAfter(caminho).data.raeId == acaoId
          && operadorRaeDaAtividade(getAfter(caminho).data)
        );
    }

    function atualizacaoRaePreservaOrigem() {
      let escalaAnterior = 'escalaId' in resource.data
        ? resource.data.escalaId
        : '';
      let atividadeAnterior = 'escalaAtividadeId' in resource.data
        ? resource.data.escalaAtividadeId
        : '';
      let escalaAtual = 'escalaId' in request.resource.data
        ? request.resource.data.escalaId
        : '';
      let atividadeAtual = 'escalaAtividadeId' in request.resource.data
        ? request.resource.data.escalaAtividadeId
        : '';
      return escalaAtual == escalaAnterior
        && atividadeAtual == atividadeAnterior;
    }

    function podeRegistrarExecucaoMissao(atividadeId) {
      let caminho = caminhoAtividadeEscala(atividadeId);
      return usuarioEscalaAtivo()
        && !administradorEscala()
        && atividadeId is string
        && atividadeId.size() > 0
        && exists(caminho)
        && get(caminho).data.naturezaAtividade == 'administrativa'
        && get(caminho).data.geraRae == false
        && get(caminho).data.status != 'cancelada'
        && get(caminho).data.escalaId is string
        && escalaPublicadaPorId(get(caminho).data.escalaId)
        && (
          get(caminho).data.coordenadorUsuarioId == request.auth.uid
          || request.auth.uid in get(caminho).data.participanteUsuarioIds
        );
    }

    function execucaoMissaoValida() {
      return request.resource.data.keys().hasOnly([
          'escalaAtividadeId',
          'escalaId',
          'data',
          'status',
          'resultadoResumo',
          'observacao',
          'evidencias',
          'executadoPorUsuarioId',
          'executadoPorMembroEquipeId',
          'executadoPorNomeSnapshot',
          'concluidoEm',
          'criadoEm',
          'atualizadoEm'
        ])
        && request.resource.data.escalaAtividadeId is string
        && request.resource.data.escalaId is string
        && request.resource.data.escalaId.size() > 0
        && request.resource.data.data is timestamp
        && exists(caminhoAtividadeEscala(
          request.resource.data.escalaAtividadeId
        ))
        && request.resource.data.escalaId
          == get(caminhoAtividadeEscala(
            request.resource.data.escalaAtividadeId
          )).data.escalaId
        && request.resource.data.data
          == get(caminhoAtividadeEscala(
            request.resource.data.escalaAtividadeId
          )).data.data
        && escalaPublicadaPorId(request.resource.data.escalaId)
        && request.resource.data.status in ['em_execucao', 'concluida', 'cancelada']
        && request.resource.data.resultadoResumo is string
        && request.resource.data.observacao is string
        && request.resource.data.evidencias is list
        && request.resource.data.evidencias.size() <= 20
        && request.resource.data.executadoPorUsuarioId == request.auth.uid
        && request.resource.data.executadoPorMembroEquipeId is string
        && request.resource.data.executadoPorMembroEquipeId.size() > 0
        && membroEquipeCompativelComUsuario(
          request.resource.data.executadoPorMembroEquipeId,
          request.auth.uid
        )
        && request.resource.data.executadoPorNomeSnapshot is string
        && request.resource.data.executadoPorNomeSnapshot.size() > 0
        && (
          request.resource.data.concluidoEm == null
          || request.resource.data.concluidoEm is timestamp
        )
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.atualizadoEm is timestamp
        && (
          request.resource.data.status != 'concluida'
          || (
            request.resource.data.resultadoResumo.size() > 0
            && request.resource.data.concluidoEm is timestamp
          )
        )
        && podeRegistrarExecucaoMissao(
          request.resource.data.escalaAtividadeId
        );
    }

    function criacaoExecucaoMissaoValida() {
      return request.resource.data.criadoEm
        == request.resource.data.atualizadoEm;
    }

    function atualizacaoExecucaoMissaoValida() {
      return resource.data.status == 'em_execucao'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'resultadoResumo',
          'observacao',
          'evidencias',
          'concluidoEm',
          'atualizadoEm'
        ]);
    }

    match /usuarios/{usuarioId} {
      // A leitura do próprio documento precisa funcionar mesmo para conta
      // inativa, permitindo que o cliente determine o estado da identidade.
      allow get: if autenticado()
        && (request.auth.uid == usuarioId || administrador());
      allow list: if administrador();

      // O fluxo administrativo altera somente o escopo. Perfil, situação
      // ativa e demais dados de identidade permanecem imutáveis no aplicativo.
      allow update: if administrador() && (
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'escopoAcesso', 'scopeUpdatedAt', 'scopeUpdatedBy'
          ])
          && escopoAcessoValido()
        ) || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'ativo', 'ativadoEm', 'ativadoPor', 'updatedAt'
          ])
          && request.resource.data.ativo is bool
          && request.resource.data.ativadoEm == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.ativadoPor == request.auth.uid
          && (
            request.resource.data.ativo == false
            || usuarioProntoParaAtivacao(usuarioId)
          )
        )
      );
      allow create: if novoUsuarioPorConviteValido(usuarioId);
      allow delete: if false;
    }

    match /convites_usuarios/{conviteId} {
      allow get: if administrador()
        || (autenticado()
          && request.auth.token.email is string
          && request.auth.token.email == resource.data.email);
      allow list: if administrador();
      allow create: if administrador() && conviteUsuarioValido();
      allow update: if autenticado()
        && resource.data.status == 'pendente'
        && resource.data.expiraEm > request.time
        && identidadeConfirmadaParaConvite(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'usuarioId', 'utilizadoEm', 'atualizadoEm'
        ])
        && request.resource.data.status == 'utilizado'
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.utilizadoEm == request.time
        && request.resource.data.atualizadoEm == request.time;
      allow delete: if false;
    }

    match /domains/{domainId} {
      allow get, list: if usuarioAtivo();
      allow create: if administradorOuGestor()
        && domainValido();
      allow update: if administradorOuGestor()
        && domainValido()
        && createdAtPreservadoOuRegularizado();
      allow delete: if false;
    }

    match /tipos_acoes/{tipoAcaoId} {
      allow get, list: if usuarioAtivo();
      allow create, update: if administradorOuGestor();
      allow delete: if false;
    }

    match /coordenadores/{coordenadorId} {
      allow get, list: if usuarioAtivo();
      allow create, update: if administrador();
      allow delete: if false;
    }

    match /equipe_operacional/{membroId} {
      // Excecao de leitura estritamente necessaria a Gestao da Escala.
      // Nao altera perfilReconhecido()/usuarioAtivo() nem libera escrita.
      allow get, list: if usuarioAtivo() || gerenteEscala();
      allow create: if (administrador() && membroEquipeValido())
        || novoMembroPorConviteValido(membroId);
      allow update: if administrador()
        && membroEquipeValido()
        && createdAtPreservadoOuRegularizado();
      allow delete: if false;
    }

    match /regionais/{regionalId} {
      allow get, list: if usuarioAtivo();
      allow create, update: if administrador();
      allow delete: if false;
    }

    match /equipes/{equipeId} {
      allow get, list: if usuarioAtivo();
      allow create, update: if administrador() && equipeValida();
      allow delete: if false;
    }

    match /projetos/{projetoId} {
      allow get, list: if usuarioAtivo();
      allow create, update: if administrador() && projetoValido();
      allow delete: if false;
    }

    match /materiais/{materialId} {
      allow get, list: if usuarioAtivo();
      allow create, update: if administrador();
      allow delete: if false;
    }

    match /acoes/{acaoId} {
      allow get, list: if usuarioAtivo();
      allow create: if usuarioAtivo() && criacaoRaeVinculadoValida(acaoId);
      allow update: if usuarioAtivo() && atualizacaoRaePreservaOrigem();
      allow delete: if administrador();
    }

    match /contadores/{contadorId} {
      allow get, create, update: if usuarioAtivo();
      allow list, delete: if false;
    }

    // ESC-001C - Escala GEDUC
    match /agenda_operacional/{compromissoId} {
      allow get, list: if responsavelEscalaAtivo();
      allow create: if responsavelEscalaAtivo() && agendaValida()
        && request.resource.data.revisao == 1
        && request.resource.data.criadoPor == request.auth.uid
        && request.resource.data.criadoEm == request.time
        && request.resource.data.situacao == 'planejamento'
        && request.resource.data.atividadeId == ''
        && agendaTemHistorico(compromissoId);
      allow update: if responsavelEscalaAtivo() && agendaValida()
        && resource.data.situacao != 'cancelada'
        && request.resource.data.revisao == resource.data.revisao + 1
        && request.resource.data.criadoPor == resource.data.criadoPor
        && request.resource.data.criadoEm == resource.data.criadoEm
        && (request.resource.data.data == resource.data.data || request.resource.data.motivo.size() > 0)
        && agendaVinculoDepoisValido(compromissoId)
        && agendaTemHistorico(compromissoId);
      allow delete: if false;
      match /historico/{eventoId} {
        allow get, list: if responsavelEscalaAtivo();
        allow create: if responsavelEscalaAtivo()
          && request.resource.data.keys().hasOnly(['acao', 'usuarioId', 'motivo', 'revisao', 'em', 'dataAnterior', 'dataNova'])
          && request.resource.data.acao in ['cadastro', 'edicao', 'remarcacao', 'cancelamento', 'vinculacao', 'aplicacao']
          && request.resource.data.usuarioId == request.auth.uid
          && request.resource.data.motivo is string
          && request.resource.data.em == request.time
          && request.resource.data.revisao is int
          && eventoId == string(request.resource.data.revisao)
          && request.resource.data.revisao == getAfter(caminhoAgenda(compromissoId)).data.revisao
          && getAfter(caminhoAgenda(compromissoId)).data.atualizadoEm == request.time
          && (request.resource.data.dataAnterior == null || request.resource.data.dataAnterior is timestamp)
          && request.resource.data.dataNova is timestamp;
        allow update, delete: if false;
      }
    }

    match /escala_configuracoes/{configId} {
      allow get, list: if usuarioEscalaAtivo();
      allow create, update: if configId == 'principal'
        && podeDesignarResponsavelEscala()
        && configuracaoEscalaValida();
      allow delete: if false;
    }

    match /escala_perfis_operacionais/{perfilId} {
      allow get, list: if usuarioEscalaAtivo();
      allow create: if podeDesignarResponsavelEscala()
        && perfilOperacionalEscalaValido()
        && request.resource.data.criadoPor == request.auth.uid;
      allow update: if podeDesignarResponsavelEscala()
        && perfilOperacionalEscalaValido()
        && request.resource.data.membroEquipeId
          == resource.data.membroEquipeId
        && request.resource.data.usuarioId == resource.data.usuarioId
        && request.resource.data.criadoPor == resource.data.criadoPor
        && request.resource.data.criadoEm == resource.data.criadoEm;
      allow delete: if false;
    }

    match /escalas/{escalaId} {
      allow get, list: if usuarioEscalaAtivo();
      allow create: if (
          podeCriarEscala()
          && criacaoEscalaInicialValida()
        ) || (
          podeAtualizarEscala()
          && criacaoRevisaoEscalaValida()
        );
      allow update: if podeAtualizarEscala() && atualizacaoEscalaValida();
      allow delete: if false;
    }

    match /escala_atividades/{atividadeId} {
      allow get, list: if usuarioEscalaAtivo();
      allow create: if podeAtualizarEscala()
        && escalaRascunhoPorId(request.resource.data.escalaId)
        && atividadeEscalaValida()
        && atividadeAgendaVinculoValido(atividadeId)
        && request.resource.data.criadoPor == request.auth.uid;
      allow update: if (
          podeAtualizarEscala()
          && escalaRascunhoPorId(request.resource.data.escalaId)
          && atividadeEscalaValida()
          && atividadeAgendaOrigemPreservada()
          && request.resource.data.escalaId == resource.data.escalaId
          && request.resource.data.data == resource.data.data
          && request.resource.data.criadoPor == resource.data.criadoPor
          && request.resource.data.criadoEm == resource.data.criadoEm
        ) || vinculacaoRaeAtividadeValida(atividadeId);
      allow delete: if false;
    }

    match /escala_alocacoes/{alocacaoId} {
      allow get, list: if usuarioEscalaAtivo();
      allow create: if podeAtualizarEscala()
        && escalaRascunhoPorId(request.resource.data.escalaId)
        && alocacaoEscalaValida()
        && criacaoClassificacaoJornadaEscalaValida()
        && (
          horasReaisNaoRegistradas()
          || (
            'origemAlocacaoId' in request.resource.data
            && request.resource.data.origemAlocacaoId is string
            && request.resource.data.origemAlocacaoId.size() > 0
          )
        )
        && request.resource.data.criadoPor == request.auth.uid;
      allow update: if (
          podeAtualizarEscala()
          && escalaRascunhoPorId(request.resource.data.escalaId)
          && alocacaoEscalaValida()
          && atualizacaoClassificacaoJornadaEscalaValida()
          && atualizacaoPlanejamentoPreservaHorasReais()
          && request.resource.data.escalaId == resource.data.escalaId
          && request.resource.data.atividadeId == resource.data.atividadeId
          && request.resource.data.membroEquipeId == resource.data.membroEquipeId
          && (
            (
              'origemAlocacaoId' in resource.data
              && request.resource.data.origemAlocacaoId
                == resource.data.origemAlocacaoId
            )
            || (
              !('origemAlocacaoId' in resource.data)
              && request.resource.data.origemAlocacaoId == ''
            )
          )
          && request.resource.data.criadoPor == resource.data.criadoPor
          && request.resource.data.criadoEm == resource.data.criadoEm
        ) || (
          podeRegistrarHorasRealizadasAlocacao()
          && alocacaoEscalaValida()
          && atualizacaoHorasRealizadasValida()
        );
      allow delete: if podeAtualizarEscala()
        && escalaRascunhoPorId(resource.data.escalaId);
    }

    match /escala_indisponibilidades/{indisponibilidadeId} {
      allow get, list: if usuarioEscalaAtivo();
      allow create: if podeAtualizarEscala()
        && indisponibilidadeEscalaValida()
        && request.resource.data.criadoPor == request.auth.uid;
      allow update: if podeAtualizarEscala()
        && indisponibilidadeEscalaValida()
        && request.resource.data.membroEquipeId == resource.data.membroEquipeId
        && request.resource.data.criadoPor == resource.data.criadoPor
        && request.resource.data.criadoEm == resource.data.criadoEm;
      allow delete: if false;
    }

    match /escala_execucoes_missao/{execucaoId} {
      allow get, list: if usuarioEscalaAtivo();
      allow create: if execucaoMissaoValida()
        && criacaoExecucaoMissaoValida();
      allow update: if execucaoMissaoValida()
        && atualizacaoExecucaoMissaoValida()
        && request.resource.data.escalaAtividadeId
          == resource.data.escalaAtividadeId
        && request.resource.data.escalaId == resource.data.escalaId
        && request.resource.data.data == resource.data.data
        && request.resource.data.executadoPorUsuarioId
          == resource.data.executadoPorUsuarioId
        && request.resource.data.executadoPorMembroEquipeId
          == resource.data.executadoPorMembroEquipeId
        && request.resource.data.executadoPorNomeSnapshot
          == resource.data.executadoPorNomeSnapshot
        && request.resource.data.criadoEm == resource.data.criadoEm;
      allow delete: if false;
    }

    // Toda coleção não inventariada permanece explicitamente bloqueada.
    // MIG-001E2 - migration collections are server-only.
    // Flutter/Web clients have no access during migration.
    match /migration_google_forms_staging/{recordId} {
      allow read, write: if false;
    }

    match /migration_batches/{batchId} {
      allow read, write: if false;

      match /changes/{changeId} {
        allow read, write: if false;
      }
    }

    match /acoes_historicas/{historicalId} {
      allow read, write: if false;
    }
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
