rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function caminhoUsuarioAtual() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function usuarioExiste() {
      return autenticado() && exists(caminhoUsuarioAtual());
    }

    function usuarioAtual() {
      return get(caminhoUsuarioAtual());
    }

    function perfilAtual() {
      return usuarioAtual().data.perfilAcesso;
    }

    function perfilReconhecido() {
      return usuarioExiste()
        && usuarioAtual().data.perfilAcesso is string
        && perfilAtual() in [
          'administrador',
          'gestor',
          'coordenador',
          'agente'
        ];
    }

    function usuarioAtivo() {
      return perfilReconhecido()
        && usuarioAtual().data.ativo == true;
    }

    function possuiPerfil(perfis) {
      return usuarioAtivo() && perfilAtual() in perfis;
    }

    function administrador() {
      return possuiPerfil(['administrador']);
    }

    function administradorOuGestor() {
      return possuiPerfil(['administrador', 'gestor']);
    }

    function domainValido() {
      return request.resource.data.keys().hasAll([
          'grupo',
          'codigo',
          'nome',
          'ordem',
          'ativo',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.grupo is string
        && request.resource.data.grupo.size() > 0
        && request.resource.data.codigo is string
        && request.resource.data.codigo.size() > 0
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.ordem is int
        && request.resource.data.ativo is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function createdAtPreservadoOuRegularizado() {
      return (
          resource.data.keys().hasAll(['createdAt'])
          && resource.data.createdAt is timestamp
          && request.resource.data.createdAt == resource.data.createdAt
        ) || (
          !resource.data.keys().hasAll(['createdAt'])
          && request.resource.data.createdAt
            == request.resource.data.updatedAt
        );
    }

    function membroEquipeValido() {
      return request.resource.data.keys().hasAll([
          'usuarioId',
          'nome',
          'vinculo',
          'podeCoordenar',
          'ativo',
          'origem',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.usuarioId is string
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.vinculo in ['agente', 'terceirizado']
        && request.resource.data.podeCoordenar is bool
        && request.resource.data.ativo is bool
        && request.resource.data.origem is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function escopoAcessoValido() {
      return request.resource.data.keys().hasAll([
          'escopoAcesso',
          'scopeUpdatedAt',
          'scopeUpdatedBy'
        ])
        && request.resource.data.escopoAcesso is map
        && request.resource.data.escopoAcesso.keys().hasOnly([
          'regionalIds',
          'equipeIds',
          'projetoIds',
          'scopeVersion'
        ])
        && request.resource.data.escopoAcesso.keys().hasAll([
          'regionalIds',
          'equipeIds',
          'projetoIds',
          'scopeVersion'
        ])
        && request.resource.data.escopoAcesso.regionalIds is list
        && request.resource.data.escopoAcesso.equipeIds is list
        && request.resource.data.escopoAcesso.projetoIds is list
        && request.resource.data.escopoAcesso.scopeVersion is int
        && request.resource.data.escopoAcesso.scopeVersion > 0
        && request.resource.data.scopeUpdatedAt is timestamp
        && request.resource.data.scopeUpdatedBy == request.auth.uid;
    }

    function equipeValida() {
      return request.resource.data.keys().hasAll([
          'nome',
          'codigo',
          'regionalIds',
          'membroIds',
          'coordenadorUserIds',
          'ativo'
        ])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.codigo is string
        && request.resource.data.regionalIds is list
        && request.resource.data.membroIds is list
        && request.resource.data.coordenadorUserIds is list
        && request.resource.data.ativo is bool;
    }

    function projetoValido() {
      return request.resource.data.keys().hasAll([
          'nome',
          'codigo',
          'regionalIds',
          'equipeIds',
          'ativo'
        ])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.codigo is string
        && request.resource.data.regionalIds is list
        && request.resource.data.equipeIds is list
        && request.resource.data.ativo is bool;
    }

    match /usuarios/{usuarioId} {
      // A leitura do próprio documento precisa funcionar mesmo para conta
      // inativa, permitindo que o cliente determine o estado da identidade.
      allow get: if autenticado() && request.auth.uid == usuarioId;
      allow list: if administrador();

      // O fluxo administrativo altera somente o escopo. Perfil, situação
      // ativa e demais dados de identidade permanecem imutáveis no aplicativo.
      allow update: if administrador()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'escopoAcesso',
          'scopeUpdatedAt',
          'scopeUpdatedBy'
        ])
        && escopoAcessoValido();
      allow create, delete: if false;
    }

    match /domains/{domainId} {
      allow get, list: if usuarioAtivo();
      allow create: if administradorOuGestor()
        && domainValido();
      allow update: if administradorOuGestor()
        && domainValido()
        && createdAtPreservadoOuRegularizado();
      allow delete: if false;
    }

    match /tipos_acoes/{tipoAcaoId} {
      allow get, list: if usuarioAtivo();
      allow create, update: if administradorOuGestor();
      allow delete: if false;
    }

    match /coordenadores/{coordenadorId} {
      allow get, list: if usuarioAtivo();
      allow create, update: if administrador();
      allow delete: if false;
    }

    match /equipe_operacional/{membroId} {
      allow get, list: if usuarioAtivo();
      allow create: if administrador() && membroEquipeValido();
      allow update: if administrador()
        && membroEquipeValido()
        && createdAtPreservadoOuRegularizado();
      allow delete: if false;
    }

    match /regionais/{regionalId} {
      allow get, list: if usuarioAtivo();
      allow create, update: if administrador();
      allow delete: if false;
    }

    match /equipes/{equipeId} {
      allow get, list: if usuarioAtivo();
      allow create, update: if administrador() && equipeValida();
      allow delete: if false;
    }

    match /projetos/{projetoId} {
      allow get, list: if usuarioAtivo();
      allow create, update: if administrador() && projetoValido();
      allow delete: if false;
    }

    match /materiais/{materialId} {
      allow get, list: if usuarioAtivo();
      allow create, update: if administrador();
      allow delete: if false;
    }

    match /acoes/{acaoId} {
      allow get, list, create, update: if usuarioAtivo();
      allow delete: if administrador();
    }

    match /contadores/{contadorId} {
      allow get, create, update: if usuarioAtivo();
      allow list, delete: if false;
    }

    // Toda coleção não inventariada permanece explicitamente bloqueada.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
